(rule
 (target platform_windows.ml)
 (action
  (copy ../../rewatch-ocaml/platform_windows.ml %{target})))

(test
 (name rewatch_ounit_tests_main)
 ; Several cases launch this executable to test concurrent subprocess capture.
 ; A sequential outer runner avoids nesting them inside OUnit worker processes;
 ; the production concurrency is still exercised by those cases themselves.
 (action
  (run %{test} -runner sequential))

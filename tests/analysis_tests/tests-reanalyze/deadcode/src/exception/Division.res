let divByLiteral = (x: int) => x / 10

let modByLiteral = (x: int) => mod(x, 10)

let divByNegativeLiteral = (x: int) => x / -1

let divBigIntByLiteral = (x: bigint) => x / 2n

let divFloatByLiteral = (x: float) => x / 2.

let divByVariable = (x: int, y: int) => x / y

let modByVariable = (x: int, y: int) => mod(x, y)

let divByZero = (x: int) => x / 0

let modByZero = (x: int) => mod(x, 0)

let divBigIntByZero = (x: bigint) => x / 0n

(rule
 (target platform.ml)
 (enabled_if
  (= %{os_type} Win32))
 (action
  (copy platform_windows.ml platform.ml)))

(rule
 (target platform.ml)
 (enabled_if
  (<> %{os_type} Win32))
 (action
  (copy platform_unix.ml platform.ml)))


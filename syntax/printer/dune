; Prints a parsetree as ReScript source, keeping comments. Res_token is here
; because the printer needs the keyword table to escape identifiers.

(library
 (name rescript_printer)
 (public_name rescript-syntax.printer)
 (flags
  (:standard -open Rescript_ast))
 (instrumentation
  (backend bisect_ppx))
 (libraries rescript_ast))

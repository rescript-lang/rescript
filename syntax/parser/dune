; Parses ReScript source into a parsetree. Some error messages print the
; parsed code, so the parser uses the printer.

(library
 (name rescript_parser)
 (public_name rescript-syntax.parser)
 (flags
  (:standard -open Rescript_ast -open Rescript_printer))
 (instrumentation
  (backend bisect_ppx))
 (libraries rescript_ast rescript_printer))

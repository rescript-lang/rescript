(env
 (static
  (flags
   (:standard -ccopt -static))))

(executable
 (name build_identity_gen)
 (modules build_identity_gen))

(rule
 (target rescript_compiler_build_identity.ml)
 ; Every compiler source, so code in a new directory is covered. Sources that
 ; are not linked into bsc only cause an extra clean rebuild after they change.
 (deps
  (source_tree ..))
 (action
  (with-stdout-to
   %{target}
   (run ./build_identity_gen.exe %{deps}))))

(library
 (name rescript_compiler_driver)
 (wrapped false)
 (modules rescript_compiler_driver rescript_compiler_build_identity)
 (instrumentation
  (backend bisect_ppx))
 (libraries common core depends flow_parser gentype syntax unix))

(executable
 (name rescript_compiler_main)
 (modules rescript_compiler_main)
 (public_name bsc)
 (package rescript)
 (instrumentation
  (backend bisect_ppx))
 (libraries rescript_compiler_driver))

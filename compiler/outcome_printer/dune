; Prints the type checker's outcome trees in ReScript syntax. It reads the
; FFI details of externals, so it cannot live in the printer library.

(library
 (name outcome_printer)
 (flags
  (:standard -open Rescript_ast -open Rescript_printer))
 (wrapped false)
 (instrumentation
  (backend bisect_ppx))
 (libraries typing rescript_printer))

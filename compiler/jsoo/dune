; Don't build the JS compiler by default as it slows down CI considerably.

(executables
 (names jsoo_playground_main)
 (flags
  (:standard -open Rescript_ast -open Rescript_printer -open Rescript_parser))
 (modes js wasm)
 (enabled_if
  (= %{profile} browser))
 (libraries
  common
  backend
  rescript_printer
  rescript_parser
  typing
  gentype
  outcome_printer
  js_of_ocaml))

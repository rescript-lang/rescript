; The browser profile builds the playground compiler; this rule pair generates a module from platform/{native,playground}.

(rule
 (target cmt_format_persistence.ml)
 (enabled_if
  (= %{profile} browser))
 (action
  (copy
   platform/playground/cmt_format_persistence.ml
   cmt_format_persistence.ml)))

(rule
 (target cmt_format_persistence.ml)
 (enabled_if
  (<> %{profile} browser))
 (action
  (copy platform/native/cmt_format_persistence.ml cmt_format_persistence.ml)))

(library
 (name ml)
 (wrapped false)
 (private_modules cmt_format_common cmt_format_persistence)
 (instrumentation
  (backend bisect_ppx))
 (libraries ext flow_parser))

; The typed tree converters of .cmt files: one text, instantiated in each
; direction (see typedtree_convert.ml.in).

(rule
 (target typedtree_export.ml)
 (deps typedtree_convert.ml.in)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo
     "(* Generated from typedtree_convert.ml.in by compiler/ml/dune. *)\nmodule S = Typedtree\nmodule D = Typedtree_boxed\nmodule L = Cmt_leaves.Export\n\n")
    (cat typedtree_convert.ml.in)))))

(rule
 (target typedtree_import.ml)
 (deps typedtree_convert.ml.in)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo
     "(* Generated from typedtree_convert.ml.in by compiler/ml/dune. *)\nmodule S = Typedtree_boxed\nmodule D = Typedtree\nmodule L = Cmt_leaves.Import\n\n")
    (cat typedtree_convert.ml.in)))))
